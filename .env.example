MISTRAL_API_KEY=votre_cle_mistral
PINECONE_API_KEY=votre_cle_pinecone
PINECONE_INDEX_NAME=mini-perplexity-pydantic-ai
PINECONE_ENVIRONMENT=us-east-1

# Phase 14 (J5) : seuil de confiance — top-1 score Pinecone en dessous duquel
# le pipeline répond "Je ne sais pas" sans appeler le LLM.
# Trop bas (0.5) = beaucoup d'hallucinations ; trop haut (0.85) = beaucoup de
# faux négatifs sur des questions valides à formulation atypique.
CONFIDENCE_THRESHOLD=0.75
